rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function isAtivo() {
      return isAuth() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.ativo == true;
    }

    function isAdmin() {
      return isAtivo() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'admin';
    }

    // ── Usuários ──────────────────────────────────────
    match /usuarios/{uid} {
      allow read:   if isAtivo();
      allow create: if isAdmin();
      allow update: if isAdmin() || request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ── Config global ─────────────────────────────────
    match /config/{docId} {
      allow read:   if isAtivo();
      allow write:  if isAtivo();
    }

    // ── Pneus ─────────────────────────────────────────
    match /pneus/{pneuId} {
      allow read:   if isAtivo();
      allow create: if isAtivo();
      allow update: if isAtivo();
      allow delete: if isAdmin();
    }

    // ── Obras ─────────────────────────────────────────
    match /obras/{obraId} {
      allow read:   if isAtivo();
      allow create: if isAtivo();
      allow update: if isAtivo();
      allow delete: if isAdmin();

      match /caminhoes/{caminhaoId} {
        allow read:   if isAtivo();
        allow create: if isAtivo();
        allow update: if isAtivo();
        allow delete: if isAtivo();
      }

      match /trocas/{trocaId} {
        allow read:   if isAtivo();
        allow create: if isAtivo();
        allow update: if false;
        allow delete: if false;
      }

      match /logs/{logId} {
        allow read:   if isAtivo();
        allow create: if isAtivo();
        allow update: if false;
        allow delete: if false;
      }
    }

    // ── Estoques por cidade ──────────────────────────
    match /estoques/{estoqueId} {
      allow read:   if isAtivo();
      allow create: if isAtivo();
      allow update: if isAtivo();
      allow delete: if isAtivo();
    }

    // ── Frota (veículos da empresa) ───────────────────
    match /veiculos/{veiculoId} {
      allow read:   if isAtivo();
      allow create: if isAtivo();
      allow update: if isAtivo();
      allow delete: if isAtivo();

      match /movimentacoes/{movId} {
        allow read:   if isAtivo();
        allow create: if isAtivo();
        allow update: if false;
        allow delete: if false;
      }
    }

  }
}
